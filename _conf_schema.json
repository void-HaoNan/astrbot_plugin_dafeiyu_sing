{
  "model": {
    "description": "唱歌音色",
    "type": "string",
    "hint": "填 RVC 模型名，比如 luotianyi、miku；auto 会按歌曲语种自动挑。",
    "default": "auto"
  },
  "pitch": {
    "description": "升降调（半音）",
    "type": "int",
    "hint": "男声转女声一般 +12，女声转女声 0。",
    "default": 0
  },
  "max_seconds": {
    "description": "每次唱多久（秒）",
    "type": "int",
    "hint": "5 到 60，太长会唱很久。",
    "default": 30
  },
  "cooldown_seconds": {
    "description": "同一会话冷却（秒）",
    "type": "int",
    "hint": "防止连着点，默认 30。",
    "default": 30
  },
  "timeout_seconds": {
    "description": "单首超时（秒）",
    "type": "int",
    "hint": "分离加换声比较慢，默认 900。",
    "default": 900
  },
  "out_keep_hours": {
    "description": "成品保留小时",
    "type": "int",
    "hint": "过期自动删，默认 24。",
    "default": 24
  }
}
